# OpenAI-compatible provider configuration.
# Supported API modes: chat_completions or responses.
TERRAMIND_API_MODE=chat_completions
# Leave empty to use the default endpoint for the selected mode.
TERRAMIND_API_URL=
TERRAMIND_API_KEY=
TERRAMIND_MODEL=
# Set to 0 only when your provider does not support strict function calling.
TERRAMIND_STRICT_TOOLS=1
TERRAMIND_TIMEOUT_MS=45000

# Development server is intentionally loopback-only.
HOST=127.0.0.1
PORT=8000
